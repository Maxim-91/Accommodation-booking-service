# Database configuration
POSTGRES_PASSWORD=replace_with_a_local_password
DATABASE_URL=postgresql+psycopg://accommodation_user:replace_with_a_local_password@127.0.0.1:5432/accommodation_db

# Secret key for symmetric algorithms (e.g., HS256, HS512)
TOKEN_KEY=replace_with_a_random_secret

# JWT Signing Algorithm (uncomment the one you use)
TOKEN_ALGORITHM=HS512
# TOKEN_ALGORITHM=RS256

# RSA Key Paths for asymmetric algorithms (uncomment if RS256 was chosen)
# Paths are relative to the Backend directory
# TOKEN_PRIVATE_KEY_PATH=Backend/private_key.pem
# TOKEN_PUBLIC_KEY_PATH=Backend/public_key.pem
